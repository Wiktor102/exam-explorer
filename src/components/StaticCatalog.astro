---
import type { CatalogPage } from "../server/pages";
import { catalogPath, examPath, taskPath } from "../lib/routes";
import { formatExamLabel, resourceUrl, solutionUrl } from "../utils/catalog";
interface Props { page: CatalogPage; }
const { page } = Astro.props;
const { catalog, type, exam, task } = page;
const tasks = task ? [task] : exam ? catalog.tasks.filter(t => t.examId === exam.id) : [];
---
<main class="static-catalog">
  <nav aria-label="Nawigacja"><a href="/">Strona główna</a> / <a href={catalogPath(type)}>{type.toUpperCase().replace('INF', 'INF.')}</a>{task && exam && <> / <a href={examPath(type, exam.id)}>{exam.code}</a></>}</nav>
  <h1>{page.title}</h1>
  <p>{page.description}</p>
  <p class="explorer-loading" role="status">Wczytywanie przeglądarki i filtrów. Poniżej znajdziesz materiały dostępne również bez JavaScript.</p>
  {exam ? <>
    <dl><dt>Kod arkusza</dt><dd>{exam.code}</dd><dt>Sesja</dt><dd>{formatExamLabel(exam)}</dd><dt>Liczba stron</dt><dd>{exam.pageCount}</dd></dl>
    <nav aria-label="Materiały"><a href={exam.pdf}>Pełny arkusz PDF</a>{' '}{exam.scoringPdf && <a href={exam.scoringPdf}>Zasady oceniania PDF</a>}{' '}<a href={solutionUrl(catalog.sourceRepository, exam.solutionFolder, catalog.sourceBranch)}>Repozytorium i rozwiązania</a></nav>
    {exam.assetFiles.length > 0 && <ul>{exam.assetFiles.map(file => <li><a href={resourceUrl(catalog.sourceRepository, exam, file, catalog.sourceBranch)}>{file}</a></li>)}</ul>}
    {tasks.map(item => <article>
      <h2><a href={taskPath(type, item.id)}>{item.heading || item.title}, część {item.part}</a></h2>
      <p>{item.typeLabel} · {item.tags.join(', ')}</p>
      <p>{item.summary}</p>
      <p><a href={item.pdf}>Zadanie PDF, strony {item.pageStart}–{item.pageEnd}</a></p>
      <div class="task-transcript">{item.text}</div>
      {item.duplicates.length > 0 && <nav aria-label="Podobne zadania"><h3>Podobne zadania</h3><ul>{item.duplicates.map(id => <li><a href={taskPath(type, id)}>{id}</a></li>)}</ul></nav>}
    </article>)}
    <h2>Arkusze z tej samej sesji</h2>
    <ul>{catalog.exams.filter(other => other.session === exam.session && other.id !== exam.id).map(other => <li><a href={examPath(type, other.id)}>{other.code}</a></li>)}</ul>
  </> : <>
    <h2>Arkusze</h2>
    <ul>{catalog.exams.map(item => <li><a href={examPath(type, item.id)}>{item.code}: {formatExamLabel(item)}</a></li>)}</ul>
    <h2>Zadania</h2>
    <ul>{catalog.tasks.map(item => <li><a href={taskPath(type, item.id)}>{item.heading || item.title}, {item.examId}, część {item.part}</a><p>{item.summary}</p></li>)}</ul>
  </>}
  <footer><a href="/polityka-prywatnosci/">Polityka prywatności</a></footer>
</main>
