---
import Page from "../layouts/Page.astro";
import App from "../App";
import { catalogPages, type CatalogPage } from "../server/pages";
export function getStaticPaths() {
  return catalogPages().map(page => ({ params: { path: page.path.slice(1, -1) }, props: { page } }));
}
interface Props { page: CatalogPage; }
const { page } = Astro.props;
---
<Page title={page.title} description={page.description} path={page.path}>
  <App client:load initialCatalog={page.catalog} initialPath={page.path} />
</Page>
