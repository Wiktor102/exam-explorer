---
import "../index.css";
import CookieConsent from "../components/ConsentIsland";
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
interface Props { title?: string; description?: string; path?: string; consent?: boolean; noindex?: boolean; }
const { title = SITE_NAME, description = SITE_DESCRIPTION, path = Astro.url.pathname, consent = true, noindex = false } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const image = `${SITE_URL}/og-image.png`;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="theme-color" content="#bfd7d2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline>
      let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      try {
        const saved = localStorage.getItem('exam-explorer-theme');
        if (saved === 'light' || saved === 'dark') theme = saved;
      } catch {}
      document.documentElement.dataset.theme = theme;
    </script>
    <script>
      import { legacyDestination } from "../lib/routes";
      const destination = legacyDestination(new URL(location.href));
      if (destination) location.replace(destination);
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('exam-explorer-theme', theme); } catch { /* Storage may be unavailable. */ }
      });
    </script>
  </head>
  <body>
    <slot />
    {consent && <CookieConsent client:only="react" />}
  </body>
</html>
